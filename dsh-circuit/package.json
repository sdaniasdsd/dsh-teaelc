{
  "name": "dsh-circuit",
  "version": "0.1.0",
  "description": "面向初中/高中的电路模拟器 DSH 插件：内嵌开源 CircuitJS1 仿真内核，提供中文学习面板、元件电压电流读数、多通道波形记录与挑战校验。",
  "license": "GPL-2.0",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdaniasdsd/dsh-teaelc.git"
  },
  "homepage": "https://github.com/sdaniasdsd/dsh-teaelc#readme",
  "bugs": {
    "url": "https://github.com/sdaniasdsd/dsh-teaelc/issues"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "COPYING.txt",
    "INSTALL.md",
    "README.md",
    "NOTICE",
    "client"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "circuit",
    "circuitjs",
    "education",
    "physics"
  ],
  "scripts": {
    "test": "node --test test/routes.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  }
}
