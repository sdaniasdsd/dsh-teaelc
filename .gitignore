# 构建 / 依赖
node_modules/
*.log
.DS_Store
Thumbs.db

# npm 缓存（沙箱内改用工作区缓存，避免写 %LOCALAPPDATA%）
.npm-cache/
release/

# 插件安装包：源码在 dsh-circuit/，tgz 由 npm pack 生成后随 Release 附件分发
*.tgz

# 可再生成的渲染产物：宣传片逐帧序列与质检抽帧（由 promo/render.js 与 promo/qc 脚本重新生成）
promo/out/
promo/smoke/

# 开发期的浏览器测试工作区（含本机 Chrome 测试配置，体积 1.7 GB，与项目代码无关）
dev-tools/dev/

# 打包 / 快照
*.zip
*.7z
*.tar.gz

# 沙箱 ACL 排障产出的临时备份与报告
acl-recovery/acl-backup-*
acl-recovery/acl-report-*

# 探针临时文件
probe.txt

# 浏览器验收脚本的截图产物（dev-tools/browser/run-all.mjs 可重新生成）
dev-tools/browser/out/
